# ---- Python / 构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
# 例外：MemCompass 的构造脚本是数据集的编写源头，冻结副本也依赖其中的 mcb.py / pools.py，必须入库
!docs/research/benchmark-suite/build/
!evals/memcompass/build/

# ---- 环境与工具缓存 ----
.venv/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.workbuddy/
.idea/
.vscode/

# ---- 运行时数据：data/ 下只保留目录占位，内容一律不入库 ----
data/**
!data/
!data/**/
!data/**/.gitkeep

# ---- 密钥与本机配置 ----
.env
.env.*
!.env.example

# ---- 本机部署脚本（含个人路径，仅作者本机使用） ----
scripts/start_http_server.cmd
scripts/register_task_s4u.ps1

# ---- 生成物 ----
# 核验台单文件页面（含全部用例，含 held-out 切分）
docs/research/benchmark-suite/tools/review/index.html
*.bak

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 仅本地保留、不公开的个人草稿 ----
docs/research/benchmark-suite/aml-inquiry-email-draft.md

# ---- 开发者私人材料与编码助手的仓库本地配置（只忽略根目录）----
/.notes/
/.claude/
