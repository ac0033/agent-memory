# 虚拟环境与构建产物
.venv/
__pycache__/
*.egg-info/
*.py[cod]
dist/
build/

# 运行时数据：忽略 data/ 下所有内容，但保留目录本身和 .gitkeep 占位
data/**
!data/
!data/**/
!data/**/.gitkeep

# 工具缓存
.pytest_cache/
.ruff_cache/
.workbuddy/

# 系统文件
.DS_Store
Thumbs.db

# 兜底：任何密钥文件都不入库
.env
.env.*
!.env.example

# 本机部署脚本（含个人路径，仅作者本机使用，不随仓库发布）
scripts/start_http_server.cmd
scripts/register_task_s4u.ps1
